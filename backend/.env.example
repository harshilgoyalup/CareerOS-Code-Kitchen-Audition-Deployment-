# ========================================================
# CareerOS Backend Environment Configuration (Placeholders)
# ========================================================

# General Configuration
PROJECT_NAME="CareerOS Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000

# Google Cloud Platform & Gemini Enterprise Agent Platform / Vertex AI
GOOGLE_CLOUD_PROJECT=coding-nija
GOOGLE_CLOUD_LOCATION=us-central1
GCP_PROJECT_ID=coding-nija
GCP_REGION=us-central1
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_key_here

# Firebase Admin Configuration (Server-Side Only)
FIREBASE_PROJECT_ID=coding-nija
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json

# Cloud Scheduler Internal Secret
INTERNAL_SCHEDULER_SECRET=your_secure_internal_scheduler_secret

# Storage Mode (Set to true for in-memory mock dev, false for live Firestore)
USE_MOCK_STORAGE=true
