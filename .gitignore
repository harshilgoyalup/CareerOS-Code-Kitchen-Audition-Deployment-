# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.production
*.env.staging
*.env.test

# Google Cloud & Firebase Credentials
*service-account*.json
*credentials*.json
*.pem
*.key
*.crt
*.pfx
*.p12
client_secrets*.json
firebase-adminsdk*.json

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# IDE & Editor Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs & Temporary Files
logs/
*.log
scratch/
tmp/
temp/
