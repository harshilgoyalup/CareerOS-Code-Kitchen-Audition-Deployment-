rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Match any document under the user's isolated data tree
    match /users/{userId} {
      // Allow user to read and write their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Jobs subcollection
      match /jobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Applications subcollection
      match /applications/{applicationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Status history events subcollection
        match /events/{eventId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Drafts subcollection
      match /drafts/{draftId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Nudges subcollection
      match /nudges/{nudgeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
