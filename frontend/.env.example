# Note: Frontend communicates with Firebase Web Auth and routes
# all AI/protected operations through the FastAPI backend.
# NEVER place Gemini or Cloud private credentials in this file.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=coding-nija.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=coding-nija
VITE_FIREBASE_STORAGE_BUCKET=coding-nija.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
